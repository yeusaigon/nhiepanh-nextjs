rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /albums/{albumId} {
      allow read: if resource.data.is_public == true || (request.auth != null && request.auth.token.email == "vietnam.tri@gmail.com");
      allow write: if request.auth != null && request.auth.token.email == "vietnam.tri@gmail.com";
    }
    match /photos/{photoId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "vietnam.tri@gmail.com";
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "vietnam.tri@gmail.com";
    }
  }
}
